<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/velocity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActivityVelocity">

    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/velocity_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />

    <View
        android:id="@+id/velocity_toucher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />


    <TextView
        android:id="@+id/velocity_desc"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:textColor="#0f0"
        android:text="hello"
        android:textSize="12sp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="10dp"
        />

    <TextView
        android:id="@+id/velocity_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:textColor="#0f0"
        android:text="hello"
        android:textSize="10sp"
        android:layout_marginEnd="220dp"
        />

    <RelativeLayout
        android:id="@+id/velocity_zoomer"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        >

        <com.github.chrisbanes.photoview.PhotoView
            android:id="@+id/velocity_zoomerimage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_centerVertical="true"
            android:foreground="#0f0"
            />

        <View
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:foreground="#0f0"
            />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="100dp"
        android:gravity="center"
        >

        <ImageButton
            android:id="@+id/velocity_b1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/outline_arrow_back_24"
            />
        <ImageButton
            android:id="@+id/velocity_b2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/outline_arrow_back_ios_24"
            />
        <ImageButton
            android:id="@+id/velocity_f2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/outline_arrow_back_ios_24"
            android:rotation="180"
            />
        <ImageButton
            android:id="@+id/velocity_f1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/outline_arrow_back_24"
            android:rotation="180"
            />
        <ImageButton
            android:id="@+id/velocity_lock"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/sharp_restart_alt_24"
            />

    </LinearLayout>

</RelativeLayout>